# Copy to .env (same folder as docker-compose.yml) and fill in real values.
# .env is gitignored - never commit real secrets.
#
# Required. Signs all access/refresh tokens. The backend refuses to start with
# APP_ENV=production unless this is 32+ characters and not a published value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
#
# Required. Password for the 'postgres' database user (used by both containers).
# Use URL-safe characters only (it is embedded in DATABASE_URL).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
#
# Optional. Email quotations to customers (Gmail SMTP). Leave SMTP_USER / SMTP_PASSWORD
# empty to run in simulation mode (nothing is sent).
# SMTP_PASSWORD must be a Google *app password* (Google Account > Security >
# 2-Step Verification > App passwords), never your normal Google password.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=VoiceQuote Dealership
# Receives a notice each time a quotation is emailed (defaults to SMTP_USER).
ADMIN_NOTIFY_EMAIL=
