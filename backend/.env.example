# ===================================================
# Two-Wheeler Dealership Backend - Environment Configuration
# ===================================================

# Application
APP_NAME="Two-Wheeler Dealership Sales Automation & Lead Management"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:meethu1206%23@localhost:5432/dealership_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:meethu1206%23@localhost:5432/dealership_test_db

# Security & JWT Authentication
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_998877665544332211
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (Comma-separated list of allowed origins, or single string)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# External Integrations - WhatsApp Business Cloud API
# When left empty, system automatically operates in graceful mock provider mode
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v18.0

# External Integrations - Google Gemini AI
# When left empty, system uses heuristic fallback recommendations & insights
GEMINI_API_KEY=

# Storage & Uploads
UPLOAD_DIR=uploads
PDF_STORAGE_DIR=generated_pdfs
